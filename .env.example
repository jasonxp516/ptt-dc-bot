# Discord Bot 憑證 (必填)
DISCORD_TOKEN=your_discord_bot_token_here

# 預設主伺服器與預設推播頻道 ID (選填，亦可進入頻道後以 /channel_set 設定)
DEFAULT_CHANNEL_ID=123456789012345678
DEFAULT_GUILD_ID=987654321098765432

# 機器人最高管理員 Discord User ID (選填，留空時會自動從主伺服器擁有者識別)
OWNER_USER_ID=

# 預設監控看板與輪詢抖動秒數區間
DEFAULT_BOARD=HardwareSale
POLL_INTERVAL_MIN=90
POLL_INTERVAL_MAX=150

# Groq Cloud API 配置 (啟用 AI 自然語言助理與語意審核時必填)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
