# Discord Bot 憑證 (必填)
DISCORD_TOKEN=your_discord_bot_token_here

# Bot display language (zh_TW, en)
BOT_LANGUAGE=zh_TW

# 預設主伺服器與預設推播頻道 ID (選填，亦可進入頻道後以 /channel_set 設定)
DEFAULT_CHANNEL_ID=123456789012345678
DEFAULT_GUILD_ID=987654321098765432

# 機器人最高管理員 Discord User ID (選填，留空時會自動從主伺服器擁有者識別)
OWNER_USER_ID=

# 預設監控看板與輪詢抖動秒數區間
DEFAULT_BOARD=HardwareSale
POLL_INTERVAL_MIN=90
POLL_INTERVAL_MAX=150

# Groq Cloud API 配置 (啟用 AI 自然語言助理與語意審核時必填)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# 選填：以逗號分隔指定完整的輪替模型清單 (設定後取代上方兩項與內建模型；Groq 下架模型時用來更換)
GROQ_MODELS=

# 未讀文章若發文時間已超過此時數則視為歷史文章、不推播 (預設 24；設 0 停用)
MAX_ARTICLE_AGE_HOURS=24

# ---- 多平台推播 (選填) ----
ENABLE_DISCORD=true
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
# 可管理任何 Telegram 群組共用規則的使用者 ID (逗號分隔)；群組管理員本身亦可管理該群組規則
TELEGRAM_ADMIN_USER_ID=
# 封鎖名單：機器人完全不回應這些 Telegram 使用者 ID (逗號分隔)
TELEGRAM_BLOCKED_USER_IDS=

# Email 為副本模式：填妥下列設定並重啟後，由擁有者在 Discord 執行 /email_copy 開啟，
# 推播成功的文章會同時寄到 EMAIL_TO
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=PTT 智慧追蹤機器人
EMAIL_TO=
